{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":prHourlyLimit2",
    "helpers:pinGitHubActionDigests",
    "schedule:weekly",
    "security:minimumReleaseAgeNpm"
  ],
  "labels": ["dependencies"],
  "timezone": "Europe/Paris",
  "ignorePaths": ["**/dist/**"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Default liquibase-linter version shipped by the action, and its mentions in the README",
      "managerFilePatterns": ["/^action\\.yaml$/", "/^README\\.md$/"],
      "matchStrings": [
        "# renovate: liquibase-linter\\s+default: '(?<currentValue>v[^']+)'",
        "\\| `version`\\s+\\| No\\s+\\| `(?<currentValue>v[^`]+)`",
        "\\n\\s+version: (?<currentValue>v\\d+\\.\\d+\\.\\d+)\\n"
      ],
      "depNameTemplate": "n2jsoft-public-org/liquibase-linter",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "The action runs on node24 (action.yaml), so keep Node and its types on that major",
      "matchPackageNames": ["node", "@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "ncc (the dist bundler) does not support TypeScript 7 (native compiler) yet: stay below 7 until it does",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "Group all GitHub Actions bumps into one PR",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Auto-merge non-major updates once required CI checks pass: Renovate merges them itself, after rebasing and retesting, with its bypass of the review required by the PR ruleset",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "automerge": true,
      "platformAutomerge": false
    },
    {
      "description": "liquibase-linter is still 0.x, where a minor bump can break the output the action parses: review those PRs by hand",
      "matchDepNames": ["n2jsoft-public-org/liquibase-linter"],
      "matchCurrentVersion": "/^v?0\\./",
      "automerge": false
    }
  ]
}
